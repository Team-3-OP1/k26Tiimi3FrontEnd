# API Configuration
# Copy this file to .env.development or .env.production and fill in the appropriate values

# Backend API URL - must end without trailing slash
VITE_API_URL=http://localhost:8080

# Optional: API timeout in milliseconds (default: 10000)
VITE_API_TIMEOUT=10000

# Optional: Enable API request logging in development
VITE_API_DEBUG=false
